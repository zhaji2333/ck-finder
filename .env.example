# =============================================================================
# ck-finder 环境变量模板（合并后：收集引擎 + Agent 编排统一配置）
# 复制为 .env 并填入真实值，.env 不提交到 git
# =============================================================================

# ---- DeepSeek LLM（必填）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI 兼容端点（默认）：
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Anthropic 兼容端点（备选）：
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner
# LLM 智能增强开关（默认全开；关闭后回退纯规则/正则）
LLM_TECH_DETECT_ENABLED=true
LLM_JS_EXTRACT_ENABLED=true
# 每个 webapp 最多对几个 JS 文件跑 LLM 接口提取（预算控制，默认 5）
LLM_JS_EXTRACT_PER_WEBAPP=5
# Agent 决策点开关（混合架构：确定性主干 + LLM 决策）
LLM_PLANNER_ENABLED=true          # 决策点1：侦察策略规划（种子→策略参数包）
LLM_TASK_SELECT_ENABLED=true      # 决策点2：深挖任务选择兜底（只增不减）
LLM_JUDGE_ENABLED=true            # 决策点3：高危动作审批（nmap 全端口/masscan 高RPS/自定义大字典）
LLM_STOP_JUDGE_ENABLED=true       # 决策点4：停止/继续判断（追加深挖一轮）
LLM_ANALYSIS_ENABLED=true         # LLM 分析驱动：页面分类/攻击面地图/架构级分析
LLM_SCORE_REVIEW_ENABLED=true      # LLM 评分复核：高分资产必须 LLM 认定（防虚高）
LLM_SCORE_REVIEW_THRESHOLD=70      # 复核触发阈值（规则分 ≥ 70 才复核）
AUTO_DEEP_SCAN_ENABLED=true        # 评分后自动深挖 L2/L3 资产
AUTO_DEEP_SCAN_MIN_LEVEL=L2        # 自动深挖最低级别

# ---- ck-finder Agent 编排（M2 起）----
# 授权范围（逗号分隔：域名 / *.域名 / IP / CIDR）
CKFINDER_SCOPE=
# Agent 执行模型（默认 deepseek-chat / deepseek-v4-flash）
CKFINDER_MODEL=deepseek-chat
# 复杂判断模型（planner/reviewer 用，留空则与执行模型相同）
CKFINDER_MODEL_PRO=
# 日志级别 debug|info|warn|error
CKFINDER_LOG_LEVEL=info

# ---- PostgreSQL ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=ckrecon
PG_PASSWORD=ckrecon_dev
PG_DB=ckrecon
PG_POOL_MAX=10

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- 外部工具服务 ----
# FofaMap MCP Server（stdio）
FOFA_MCP_CMD=python
FOFA_MCP_ARGS=mcp_server.py
FOFA_MCP_CWD=
# FOFA 凭证（写入 FofaMap 的 config/settings.yaml，此处仅占位）
FOFA_EMAIL=
FOFA_KEY=

# ICP_Query HTTP 服务
ICP_QUERY_URL=http://127.0.0.1:16181

# ---- 工具执行器配置 ----
# 全局超时（秒）
TOOL_TIMEOUT_SEC=600
# 全局并发上限
TOOL_CONCURRENCY=4
# 主动工具限速（每秒请求数，0=不限）
ACTIVE_RPS=2

# ---- Scope Gate（M2 启用）----
SCOPE_GATE_ENABLED=false
# 授权范围（逗号分隔的域名/IP/CIDR，与 CKFINDER_SCOPE 可互补）
SCOPE_ALLOWED=

# ---- 源码收集 ----
# 源码落地根目录（相对路径基于项目根）
SOURCES_DIR=./sources
# 单站点源码下载体积上限（MB），0=不限
SOURCE_MAX_SIZE_MB=500

# ---- 服务模式 ----
REST_PORT=8787
MCP_PORT=8788
LOG_LEVEL=info
